# Example environment variables for agent-memory.
# Note: The library uses explicit configuration objects, not environment variables.
# These variables are provided to simplify passing secrets to your own configuration.

# OpenAI API key (required for embedding and LLM extraction)
OPENAI_API_KEY=your-openai-api-key-here

# Cohere (optional — alternative embedding provider)
# COHERE_API_KEY=your-cohere-api-key-here

# HuggingFace (optional — alternative embedding provider)
# HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# Optional: custom base URLs for self-hosted or proxy setups
# OPENAI_BASE_URL=https://api.openai.com/v1

# Planned: Observability
# LOG_LEVEL=info
# METRICS_ENABLED=false
# TRACING_ENABLED=false

# Planned: Encryption key for at-rest encryption
# ENCRYPTION_KEY=your-secure-encryption-key
